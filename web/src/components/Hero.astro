---
import { Image, Picture } from 'astro:assets';
import appStoreBadge from '../assets/app-store-badge.svg';
import heroImage from '../assets/hero.jpg';
import { APP_STORE_URL } from '../consts';
---

<section class="hero">
	<div class="frame">
		<Picture
			src={heroImage}
			alt="Clay diorama of a skeleton in a captain's hat, pipe in its teeth, steering a ship's wheel on a wooden surfboard through a curling wave under a full moon."
			formats={['avif', 'webp']}
			widths={[640, 960, 1280, 1600, 2000]}
			sizes="(min-width: 90rem) 86rem, (min-width: 54rem) calc(100vw - 4rem), 122vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="copy">
			<p class="eyebrow">skelly</p>
			<h1>Surf the web in bare bones</h1>
			<p class="lede">
				Skelly is a browser that strips websites down to the bone. Switch off
				JavaScript and most ads, trackers, and pop-ups go with it. And the
				browser itself collects nothing, so what you do stays yours.
			</p>
			<a class="badge" href={APP_STORE_URL}>
				<Image src={appStoreBadge} alt="Download on the App Store" loading="eager" />
			</a>
		</div>
	</div>
</section>

<style>
	/* Phones and small tablets: the image runs edge to edge with the skelly
	   label in its corner, and the rest of the copy stacks below it. */
	.hero {
		max-width: 90rem;
		margin-inline: auto;
		padding-bottom: clamp(3rem, 8vw, 5rem);
	}

	.frame {
		container: hero / inline-size;
		position: relative;
	}

	/* The right of the image is empty sky meant for the desktop copy, so on
	   narrow screens crop ~18% of it off (about 80px on a phone) for a
	   squarer frame and a bigger skeleton. */
	.frame picture :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1648 / 1116;
		object-fit: cover;
		object-position: left center;
	}

	/* Apple's official badge, unmodified. Min 40px tall on screen, with clear
	   space of a quarter of its height around it. */
	.badge {
		display: block;
		margin-top: 0.75rem;
		border-radius: 0.6rem;
	}

	.badge :global(img) {
		display: block;
		height: 3.75rem;
		width: auto;
	}

	.badge:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 3px;
	}

	.copy {
		display: grid;
		gap: 1rem;
		justify-items: start;
		padding: 2rem var(--gutter) 0;
	}

	/* On narrow screens the label sits in the image's top-left corner, lined
	   up with the copy below, to save vertical space. */
	.eyebrow {
		position: absolute;
		top: var(--gutter);
		left: var(--gutter);
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: #f4f1ea;
		text-shadow: 1px 2px 2px #000000d4;
	}

	h1 {
		font-size: clamp(2.25rem, 9vw, 3.5rem);
		max-width: 12ch;
	}

	.lede {
		font-size: 1.125rem;
		color: var(--muted);
		max-width: 40ch;
	}

	/* Wide screens: the image gets a gutter and rounded corners, and the copy
	   sits over the night sky on its right. The image is dark in both themes,
	   so the text keeps fixed light colors. */
	@media (width >= 54rem) {
		.hero {
			padding-top: var(--gutter);
			padding-inline: var(--gutter);
		}

		.frame picture :global(img) {
			aspect-ratio: auto;
			border-radius: clamp(0.75rem, 2vw, 1.5rem);
		}

		.copy {
			position: absolute;
			top: 27%;
			left: 55%;
			right: 5%;
			isolation: isolate;
			gap: 1.2cqi;
			padding: 0;
			color: #f4f1ea;
			text-shadow: 1px 2px 2px #000000d4;
		}

		/* Soft night-sky glow behind the text to calm the spray and whitewater. */
		.copy::before {
			content: '';
			position: absolute;
			inset: -18% -12% -22% -14%;
			z-index: -1;
			background: radial-gradient(
				closest-side,
				rgb(12 16 46 / 0.72),
				rgb(12 16 46 / 0.45) 65%,
				transparent
			);
		}

		.eyebrow {
			position: static;
			font-size: calc(max(0.8rem, 1.1cqi) + 2px);
			color: #cfd3ea;
		}

		h1 {
			font-size: 4.2cqi;
			max-width: none;
		}

		.lede {
			font-size: max(1rem, 1.3cqi);
			color: #dde0f0;
			max-width: 34ch;
		}

		.badge {
			margin-top: 0.8cqi;
		}

		.badge :global(img) {
			height: max(3.125rem, 4.5cqi);
		}

		.badge:focus-visible {
			outline-color: #f4f1ea;
		}
	}
</style>
