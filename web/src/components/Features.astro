---
import { Image } from 'astro:assets';
import skellyWink from '../assets/skelly-wink.png';

const features = [
	{
		title: 'No ads',
		body: 'Ads run on JavaScript. Switch it off and they never get the chance to load.',
	},
	{
		title: 'No trackers',
		body: 'Tracking scripts can’t follow you around when scripts don’t run.',
	},
	{
		title: 'No cookie banners',
		body: 'Consent pop-ups are scripts too, so they stay out of your way.',
	},
	{
		title: 'Privacy first',
		body: 'Zero data collected. Not even analytics. What you browse, search, and read in Skelly is yours alone.',
	},
	{
		title: 'Speed',
		body: 'Pages without the extra weight load in a blink and go easy on your data and battery.',
	},
	{
		title: 'Read aloud',
		body: 'Sit back and let Skelly read any page to you.',
	},
	{
		title: 'Quick dial & news feed',
		body: 'Pin your favorite news sites for one-tap access and catch up on all of them in one feed.',
	},
	{
		title: 'And more…',
		body: 'Skelly clears away the rest of the clutter that gets between you and what you came to read.',
	},
];
---

<section class="features container" aria-labelledby="features-title">
	<h2 id="features-title">Why Skelly</h2>
	<ul>
		{
			features.map(({ title, body }) => (
				<li class="card">
					<h3>{title}</h3>
					<p>{body}</p>
				</li>
			))
		}
		<li class="mascot" aria-hidden="true">
			<Image src={skellyWink} alt="" widths={[160, 320, 400]} sizes="10rem" />
		</li>
	</ul>
</section>

<style>
	.features {
		container: features / inline-size;
		padding-block: clamp(3rem, 8vw, 5rem);
		border-top: 1px solid var(--line);
	}

	h2 {
		font-size: clamp(1.5rem, 4vw, 2rem);
		margin-bottom: 2rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}

	.card {
		display: grid;
		gap: 0.5rem;
		padding: 1.5rem;
		border-radius: 1rem;
		background: var(--surface);
	}

	h3 {
		font-size: 1.125rem;
	}

	p {
		color: var(--muted);
	}

	/* On one or two columns the winking skelly closes the list on its own row. */
	.mascot {
		grid-column: 1 / -1;
		justify-self: center;
		width: 10rem;
		margin-top: 1rem;
	}

	.mascot :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* On three columns (3 × 16rem + gaps) it fills the empty last cell, sized
	   to the row so it never makes the cards taller. */
	@container features (width >= 50rem) {
		.mascot {
			grid-column: auto;
			justify-self: stretch;
			position: relative;
			width: auto;
			margin-top: 0;
		}

		.mascot :global(img) {
			position: absolute;
			inset: 0;
		}
	}
</style>
