---
import { Image, Picture } from 'astro:assets';
import appStoreBadge from '../assets/app-store-badge.svg';
import heroImage from '../assets/hero.jpg';
import { APP_STORE_URL } from '../consts';
---

<section class="hero">
	<div class="frame">
		<Picture
			src={heroImage}
			alt="Clay diorama of a skeleton in a captain's hat, pipe in its teeth, steering a ship's wheel on a wooden surfboard through a curling wave under a full moon."
			formats={['avif', 'webp']}
			widths={[640, 960, 1280, 1600, 2000]}
			sizes="(min-width: 90rem) 86rem, (min-width: 54rem) calc(100vw - 4rem), 100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="copy">
			<p class="eyebrow">skelly</p>
			<h1>Surf the web in bare bones</h1>
			<p class="lede">
				Skelly is a browser that strips websites down to the bone. Switch off
				JavaScript and most ads, trackers, and pop-ups go with it, leaving
				fast, quiet pages that get out of your way.
			</p>
			<a class="badge" href={APP_STORE_URL}>
				<Image src={appStoreBadge} alt="Download on the App Store" loading="eager" />
			</a>
		</div>
	</div>
</section>

<style>
	/* Phones and small tablets: the image runs edge to edge with the title over
	   its night sky, and the rest of the copy stacks below. .copy steps aside
	   (display: contents) so its children share the frame's grid with the
	   image. */
	.hero {
		max-width: 90rem;
		margin-inline: auto;
		padding-bottom: clamp(3rem, 8vw, 5rem);
	}

	.frame {
		--night-glow: radial-gradient(
			closest-side,
			rgb(12 16 46 / 0.72),
			rgb(12 16 46 / 0.45) 65%,
			transparent
		);

		container: hero / inline-size;
		position: relative;
		display: grid;
		row-gap: 1rem;
		overflow-x: clip;
	}

	.frame picture {
		grid-area: 1 / 1;
	}

	.frame picture :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Apple's official badge, unmodified. Min 40px tall on screen, with clear
	   space of a quarter of its height around it. */
	.badge {
		display: block;
		margin-top: 0.75rem;
		border-radius: 0.6rem;
	}

	.badge :global(img) {
		display: block;
		height: 3.75rem;
		width: auto;
	}

	.badge:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 3px;
	}

	.copy {
		display: contents;
	}

	.eyebrow,
	.lede,
	.badge {
		justify-self: start;
		margin-inline: var(--gutter);
	}

	.eyebrow {
		margin-top: 1rem;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--muted);
	}

	h1 {
		grid-area: 1 / 1;
		align-self: start;
		position: relative;
		isolation: isolate;
		margin: 14cqi 4cqi 0 48cqi;
		font-size: 6.6cqi;
		color: #f4f1ea;
		text-shadow: 1px 2px 2px #000000d4;
	}

	/* Soft night-sky glow behind the text to calm the spray and whitewater. */
	h1::before {
		content: '';
		position: absolute;
		inset: -35% -14%;
		z-index: -1;
		background: var(--night-glow);
	}

	.lede {
		font-size: 1.125rem;
		color: var(--muted);
		max-width: 40ch;
	}

	/* Wide screens: the image gets a gutter and rounded corners, and the copy
	   sits over the night sky on its right. The image is dark in both themes,
	   so the text keeps fixed light colors. */
	@media (width >= 54rem) {
		.hero {
			padding-top: var(--gutter);
			padding-inline: var(--gutter);
		}

		.frame {
			display: block;
		}

		.frame picture :global(img) {
			border-radius: clamp(0.75rem, 2vw, 1.5rem);
		}

		.copy {
			display: grid;
			justify-items: start;
			position: absolute;
			top: 27%;
			left: 55%;
			right: 5%;
			isolation: isolate;
			gap: 1.2cqi;
			color: #f4f1ea;
			text-shadow: 1px 2px 2px #000000d4;
		}

		/* The glow moves from the title to the whole copy block. */
		h1::before {
			content: none;
		}

		.copy::before {
			content: '';
			position: absolute;
			inset: -18% -12% -22% -14%;
			z-index: -1;
			background: var(--night-glow);
		}

		.eyebrow,
		.lede,
		.badge {
			margin-inline: 0;
		}

		.eyebrow {
			margin-top: 0;
			font-size: max(0.8rem, 1.1cqi);
			color: #cfd3ea;
		}

		h1 {
			grid-area: auto;
			margin: 0;
			font-size: 4.2cqi;
		}

		.lede {
			font-size: max(1rem, 1.3cqi);
			color: #dde0f0;
			max-width: 34ch;
		}

		.badge {
			margin-top: 0.8cqi;
		}

		.badge :global(img) {
			height: max(3.125rem, 4.5cqi);
		}

		.badge:focus-visible {
			outline-color: #f4f1ea;
		}
	}
</style>
