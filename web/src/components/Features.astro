---
const features = [
	{
		title: 'No ads',
		body: 'Ads run on JavaScript. Switch it off and they never get the chance to load.',
	},
	{
		title: 'No trackers',
		body: 'Tracking scripts can’t follow you around when scripts don’t run.',
	},
	{
		title: 'No cookie banners',
		body: 'Consent pop-ups are scripts too, so they stay out of your way.',
	},
	{
		title: 'Privacy first',
		body: 'Zero data collected. Not even analytics. What you browse, search, and read in Skelly is yours alone.',
	},
	{
		title: 'Speed',
		body: 'Pages without the extra weight load in a blink and go easy on your data and battery.',
	},
	{
		title: 'Read aloud',
		body: 'Sit back and let Skelly read any page to you.',
	},
	{
		title: 'Quick dial & news feed',
		body: 'Pin your favorite news sites for one-tap access and catch up on all of them in one feed.',
	},
	{
		title: 'And more…',
		body: 'Skelly clears away the rest of the clutter that gets between you and what you came to read.',
	},
];
---

<section class="features container" aria-labelledby="features-title">
	<h2 id="features-title">Why Skelly</h2>
	<ul>
		{
			features.map(({ title, body }) => (
				<li>
					<h3>{title}</h3>
					<p>{body}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.features {
		padding-block: clamp(3rem, 8vw, 5rem);
		border-top: 1px solid var(--line);
	}

	h2 {
		font-size: clamp(1.5rem, 4vw, 2rem);
		margin-bottom: 2rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}

	li {
		display: grid;
		gap: 0.5rem;
		padding: 1.5rem;
		border-radius: 1rem;
		background: var(--surface);
	}

	h3 {
		font-size: 1.125rem;
	}

	p {
		color: var(--muted);
	}
</style>
