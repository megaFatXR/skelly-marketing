---
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="container">
	<p>© {year} Skelly · <a href={withBase('privacy/')}>Privacy Policy</a></p>
	<p class="note">This page ships zero JavaScript.</p>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-block: 2rem 3rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.875rem;
	}

	a {
		text-underline-offset: 0.2em;
	}

	a:hover {
		color: var(--text);
	}

	.note {
		font-family: var(--font-mono);
	}
</style>
